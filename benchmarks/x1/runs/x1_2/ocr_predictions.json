          "end_sec": 1421.0,
          "text": "咱们吃涮羊肉",
          "text_sha256": "1d4b965330b2af177af7653f400913c963c023daa726992598dcf2ac0e665fb7"
        },
        {
          "start_sec": 1421.0,
          "end_sec": 1422.0,
          "text": "蒙古馆子的羊肉",
          "text_sha256": "abf4af3d53f9ad9853d4b2f2c2beb94c1e001b2ad44f377a31d85c52050eaa6a"
        },
        {
          "start_sec": 1424.0,
          "end_sec": 1425.0,
          "text": "叔伯在的时候倒是经常吃",
          "text_sha256": "3d61c3d37781ae1f06c7de54d288e82f00d7f7c1b89298fa5712b8bdebe810ab"
        },
        {
          "start_sec": 1426.0,
          "end_sec": 1427.0,
          "text": "眼下吃顿羊肉啊",
          "text_sha256": "04bf72b22249c18995d307612606646a5ec10696ee45470bc79ee5968d8d8d93"
        },
        {
          "start_sec": 1428.0,
          "end_sec": 1430.0,
          "text": "就像过年一样",
          "text_sha256": "7195ea79899af33194136d923a6207857f31559b57a64809d021f1321cff8a36"
        },
        {
          "start_sec": 1433.0,
          "end_sec": 1435.0,
          "text": "羊肉还是包大包子好吃啊",
          "text_sha256": "13348ab1466354db3f5966aa97b8ac73db4100ad7c6886f04370ab9aa5fad8bc"
        }
      ]
    },
