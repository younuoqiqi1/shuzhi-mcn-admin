{
  "schema_version": "human-anchor/1.2.2",
  "title": "Generic audiovisual observation anchor",
  "content_independent": true,
  "fields": {
    "shot_boundary_usability": ["usable", "unusable", "uncertain"],
    "visible_person_count": ["0", "1", "2", "3", "4+", "uncertain"],
    "person_consistency_pair": {
      "decision": ["same_person", "different_person", "uncertain"],
      "selection": "Click a visible person location in each raw frame; store normalized image coordinates; do not assign person IDs."
    },
    "scene_environment": {
      "values": ["indoor", "outdoor", "vehicle_interior", "transition_unclear", "other", "uncertain"],
      "optional_detail_max_chars": 24
    },
    "observable_actions": {
      "values": ["sitting_or_standing", "moving", "speaking_or_interacting", "handling_object", "other", "no_clear_action", "uncertain"],
      "multi_select": true,
      "optional_detail_max_chars": 24
    },
    "key_visible_objects": {
      "values": ["furniture", "container", "paper_or_document", "device_or_tool", "vehicle", "food_or_drink", "other", "no_key_object", "uncertain"],
      "multi_select": true,
      "optional_detail_max_chars": 24
    },
    "speech_status": ["intelligible_speech_audible", "no_intelligible_speech", "uncertain"],
    "speaker_source": ["on_screen_person", "off_screen_voice", "uncertain"],
    "speaker_location": "Optional normalized coordinates on a raw representative frame only when speech_status is intelligible_speech_audible, speaker_source is on_screen_person, and location is clear. Omit when unclear; never required for task completion or scoring.",
    "unknown": "Explicit uncertain choice for each applicable field."
  },
  "field_applicability": {
    "speaker_source": {
      "required_only_when": "speech_status == intelligible_speech_audible",
      "no_intelligible_speech": "not_applicable; no source selection required",
      "uncertain": "unassessed; no source selection required",
      "legacy_values": "Preserve prior raw values; ignore source/location when speech is not intelligible_speech_audible. Do not replace missing with uncertain."
    }
  },
  "not_collected": [
    "verbatim_transcript", "CER", "WER", "stable_person_id",
    "speaker_person_id", "speaker_confidence", "plot", "real_identity",
    "relationship", "motivation", "emotion", "narrative_significance"
  ],
  "provenance": ["existing_manifest_shot_id", "source_time_interval", "original_frame_or_video"]
}
