{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Legacy retrieval audit result; NOT Evidence Schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "query_id",
    "status",
    "candidates",
    "actual_legacy_fields_used",
    "requirements_not_representable",
    "failure_hypotheses",
    "hypothesis_status",
    "error"
  ],
  "properties": {
    "query_id": {
      "enum": [
        "Q1",
        "Q2",
        "Q3",
        "Q4",
        "Q5"
      ]
    },
    "status": {
      "enum": [
        "FOUND",
        "INSUFFICIENT",
        "ERROR"
      ]
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rank",
          "shot_id",
          "frame_ids",
          "source_time_range",
          "legacy_field_citations",
          "supported_requirements",
          "unsupported_requirements"
        ],
        "properties": {
          "rank": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3
          },
          "shot_id": {
            "type": "string",
            "minLength": 1
          },
          "frame_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "source_time_range": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "start",
              "end"
            ],
            "properties": {
              "start": {
                "type": "number",
                "minimum": 0
              },
              "end": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          },
          "legacy_field_citations": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "source_path",
                "json_pointer",
                "legacy_field",
                "quoted_original_value",
                "use_in_requirement"
              ],
              "properties": {
                "source_path": {
                  "type": "string",
                  "minLength": 1
                },
                "json_pointer": {
                  "type": "string",
                  "minLength": 1
                },
                "legacy_field": {
                  "type": "string",
                  "minLength": 1
                },
                "quoted_original_value": {},
                "use_in_requirement": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "minItems": 1
          },
          "supported_requirements": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "unsupported_requirements": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      },
      "maxItems": 3
    },
    "actual_legacy_fields_used": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_path",
          "json_pointer",
          "legacy_field",
          "quoted_original_value",
          "use_in_requirement"
        ],
        "properties": {
          "source_path": {
            "type": "string",
            "minLength": 1
          },
          "json_pointer": {
            "type": "string",
            "minLength": 1
          },
          "legacy_field": {
            "type": "string",
            "minLength": 1
          },
          "quoted_original_value": {},
          "use_in_requirement": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "requirements_not_representable": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "requirement",
          "limitation_type",
          "basis"
        ],
        "properties": {
          "requirement": {
            "type": "string",
            "minLength": 1
          },
          "limitation_type": {
            "enum": [
              "missing_dedicated_structure",
              "free_text_only",
              "observation_missing_or_failed",
              "undetermined"
            ]
          },
          "basis": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "failure_hypotheses": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "hypothesis_status": {
      "const": "undetermined_pending_evaluator"
    },
    "error": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "FOUND"
          }
        }
      },
      "then": {
        "properties": {
          "candidates": {
            "minItems": 1
          },
          "error": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "candidates": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "ERROR"
          }
        }
      },
      "then": {
        "properties": {
          "error": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "else": {
        "properties": {
          "error": {
            "type": "null"
          }
        }
      }
    }
  ]
}
